{
  "name": "portfolio-profissional",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:compat": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=functions.js && esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=public/functions.js",
    "sync:compat:watch": "npm run sync:compat -- --watch",
